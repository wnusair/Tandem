# The Tandem control-plane server. Pure Python, so a slim base is fine.
FROM python:3.12-slim

WORKDIR /srv

# Install the server's dependencies first so the layer caches across code edits.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Then the server code itself.
COPY server/ ./server/

WORKDIR /srv/server
EXPOSE 6767

# run.py binds 0.0.0.0:6767. The migrations run first, so a fresh container
# comes up with a schema instead of erroring on the first query.
CMD ["sh", "-c", "flask --app app db upgrade && python run.py"]
